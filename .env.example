# KRTime API — copy to `.env` (local) or `.env.production` (Dokploy).
# Never commit real `.env` / `.env.production` with secrets.

# =============================================================================
# 1) PostgreSQL (REQUIRED) — psycopg (sync), NOT asyncpg
# =============================================================================
DATABASE_URL=postgresql+psycopg://attendguard:CHANGE_ME_DB_PASSWORD@YOUR_DB_HOST:5432/attendguard

# =============================================================================
# 2) Public URLs
# =============================================================================
APP_NAME=KRTime
APP_ENV=production
API_PUBLIC_URL=https://api-attendance.YOURDOMAIN.com
ADMIN_PUBLIC_URL=https://attendance.YOURDOMAIN.com
CORS_ORIGINS=https://attendance.YOURDOMAIN.com

# =============================================================================
# 3) Auth / JWT
# =============================================================================
JWT_SECRET=CHANGE_ME_to_a_long_random_string_at_least_48_characters
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=14
REFRESH_COOKIE_NAME=attendguard_refresh
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax

BOOTSTRAP_ADMIN_EMAIL=admin@YOURDOMAIN.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_StrongAdminPass1
BOOTSTRAP_ADMIN_NAME=KRTime Admin

# =============================================================================
# 4) Face embedding encryption (REQUIRED when APP_ENV=production)
#    python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# =============================================================================
EMBEDDING_ENCRYPTION_KEY=CHANGE_ME_base64_32_byte_key

# =============================================================================
# 5) ntfy push (OPTIONAL)
# =============================================================================
NTFY_BASE_URL=https://ntfy.YOURDOMAIN.com
NTFY_PUBLIC_URL=https://ntfy.YOURDOMAIN.com
NTFY_ADMIN_TOPIC=krtime-admin
NTFY_TOKEN=

# =============================================================================
# 6) Object storage / S3 (OPTIONAL — backups)
# =============================================================================
S3_ENDPOINT_URL=https://YOUR_S3_OR_MINIO_ENDPOINT
S3_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_SECRET_KEY
S3_BUCKET=attendguard-backups
S3_REGION=auto

# =============================================================================
# 7) App behaviour
# =============================================================================
FACE_ENFORCEMENT=optional
FACE_MATCH_THRESHOLD=0.363
DEFAULT_GEOFENCE_RADIUS_M=30
QR_WINDOW_SECONDS=30
CHALLENGE_TTL_SECONDS=60
REVIEW_PHOTO_DIR=/app/data/review_photos
UVICORN_WORKERS=2
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT=30
LOGIN_RATE_WINDOW_SECONDS=300
ATTENDANCE_RATE_LIMIT=60
ATTENDANCE_RATE_WINDOW_SECONDS=60
BUSINESS_TIMEZONE=Asia/Kolkata
